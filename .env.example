# AutoMedia Environment Configuration
#
# Copy this file to .env and fill in your values:
#
#   cp .env.example .env
#
# The pipeline reads .env lazily — the first time a credential or an
# AUTOMEDIA_* config value is needed. Importing automedia never writes .env
# values into the process environment.
# Priority: environment variables > .env > file config > built-in defaults
#
# All AUTOMEDIA_* variables map to automedia/manifests/defaults.yaml keys,
# except a few engine-direct variables (marked below) that the engine
# implementations read straight from the environment.

# ============================================================
# LLM Provider
# ============================================================

# Supported providers: deepseek, openai, zhipu, moonshot, qwen, anthropic
AUTOMEDIA_LLM_PROVIDER=deepseek

# Model identifier (e.g. deepseek-chat, gpt-4o, claude-3-opus, moonshot-v1)
AUTOMEDIA_LLM_MODEL=deepseek-chat

# API base URL for the provider
AUTOMEDIA_LLM_BASE_URL=https://api.deepseek.com/v1

# API key (required — the pipeline will fail to start without it)
AUTOMEDIA_LLM_API_KEY=sk-your-key-here

# LLM sampling parameters (optional)
# AUTOMEDIA_LLM_TEMPERATURE=0.7
# AUTOMEDIA_LLM_MAX_TOKENS=4096

# LLM request timeout in seconds (default: 60)
# AUTOMEDIA_LLM_TIMEOUT=60

# Set to 1 to use deterministic mock LLM responses instead of real API calls.
# Useful for testing, CI, and offline pipelines.
# AUTOMEDIA_FAKE_LLM=1

# ============================================================
# Pipeline
# ============================================================

# Default brand identifier for automedia run (overridable via --brand flag)
AUTOMEDIA_DEFAULT_BRAND=my-brand

# Optional open-core feature tier override: core | pro | enterprise.
# When unset (default) every feature tier is available (free local = everything open).
# When set, gates in tiers ABOVE the override tier are excluded at gate-list
# composition (declarative marker only — no license logic).
# AUTOMEDIA_FEATURE_TIER=pro

# Default pipeline mode: auto, text_only, video_only, qa_only
AUTOMEDIA_DEFAULT_MODE=auto

# Enable the G1 humanize-verify loop (issue #62): any value other than "" or "0"
# turns it on. Primary toggle: config gates.humanizer.verify_loop.enabled
# (default: off; budget via max_iterations, default 3).
# AUTOMEDIA_HUMANIZER_VERIFY_LOOP=1

# Root directory for AutoMedia projects (defaults to working directory)
# AUTOMEDIA_PROJECTS_DIR=/var/automedia/projects

# AssetLibrary root copied into every new project (optional). The directory
# must contain _tools/pull_assets.py; unset uses the built-in workspace default.
# A missing library only warns and never blocks project creation.
# AUTOMEDIA_ASSET_LIBRARY=/path/to/AssetLibrary
# Set to 1/true/yes to skip the project-init asset pull entirely.
# AUTOMEDIA_SKIP_ASSET_PULL=1

# ============================================================
# MCP Server
# ============================================================

# Path to the MCP allowlist YAML file (optional).
# When unset, the server looks for mcp_allowlist.yaml next to the server module.
# Point this only at a file that exists: a missing path blocks all file access.
# AUTOMEDIA_MCP_ALLOWLIST_PATH=/etc/automedia/mcp_allowlist.yaml

# MCP transport: "stdio" (default) or "streamable-http".
# stdio carries no credential the server can verify, so authentication only
# exists on HTTP.  Leave unset for local/agent use.
AUTOMEDIA_MCP_TRANSPORT=stdio

# Required when AUTOMEDIA_MCP_TRANSPORT=streamable-http — the server refuses to
# start without it (fail-closed).  Clients send it as
# "Authorization: Bearer <token>".
AUTOMEDIA_MCP_AUTH_TOKEN=

# HTTP bind address / port (only used when the transport is streamable-http).
AUTOMEDIA_MCP_HOST=127.0.0.1
AUTOMEDIA_MCP_PORT=8000

# ============================================================
# Paths (override defaults from automedia/manifests/defaults.yaml)
# ============================================================

AUTOMEDIA_DATA_DIR=./data
AUTOMEDIA_OUTPUT_DIR=./output
# AUTOMEDIA_CACHE_DIR=./cache
# AUTOMEDIA_LOG_DIR=./logs
AUTOMEDIA_POOL_DB=./data/pool.db

# ============================================================
# User Configuration Directory
# ============================================================

# Override the user configuration directory (defaults to ~/.automedia).
# Useful in CI/CD, Docker, or agent environments where $HOME may not
# be available or writable.  All config files, credentials, overrides,
# brand profiles, and audit logs are resolved relative to this path.
# AUTOMEDIA_CONFIG_DIR=/var/automedia/config

# ============================================================
# Credentials & Security
# ============================================================

# Keyring backend preference: auto, secret-service, kwallet
AUTOMEDIA_KEYRING_BACKEND=auto

# Master key for AES-256-GCM credential encryption (required for AccountStore).
# Minimum 16 characters. Generate with: python3 -c "import secrets; print(secrets.token_hex(16))"
# AUTOMEDIA_MASTER_KEY=your-master-key-here

# Log format: "json" for log aggregators, "console" for human-readable terminal output
# AUTOMEDIA_LOG_FORMAT=console

# ============================================================
# Image Generation (ComfyUI, optional)
# Only needed for pipelines that generate images via ComfyUI. The three
# endpoint keys below can be set as env vars OR in .automedia/config.yaml
# (engines.image.comfyui.{host, port, protocol}); the remaining keys are
# file-config only. ComfyUI may run on another machine — see
# docs/user/hardware-and-remote-engines.md for the remote-engine guide.
#
# Remote ComfyUI endpoint (env form of engines.image.comfyui.*):
# AUTOMEDIA_ENGINES_IMAGE_COMFYUI_HOST=127.0.0.1
# AUTOMEDIA_ENGINES_IMAGE_COMFYUI_PORT=8188
# AUTOMEDIA_ENGINES_IMAGE_COMFYUI_PROTOCOL=http
#
# The built-in SD1.5 workflow renders at native resolution and upscales with an
# ESRGAN model. RealESRGAN_x4plus.pth must exist in <ComfyUI>/models/upscale_models/
# or image generation fails at runtime (EngineExecutionError — no silent fallback).
# Download: https://github.com/xinntao/Real-ESRGAN/releases
#
# Lets `automedia doctor` verify the model is present. Leave unset when ComfyUI
# runs remotely or in Docker; doctor then reports it as unverifiable, not missing.
# comfyui_models_path: /opt/ComfyUI/models
#
# Alternate ESRGAN model file name.
# upscale_model: RealESRGAN_x4plus.pth
#
# Native generation resolution: the long edge of the image ComfyUI actually
# renders, before upscaling. Keep at 512 for SD1.5 — raising it is what causes
# structural corruption (duplicate subjects, extra limbs) and slowness.
# Each side is aligned to a multiple of 8 and the requested aspect ratio is kept.
# base_size: 512

# ============================================================
# Engine-direct environment variables
# These are read by individual engine implementations, NOT mapped into
# defaults.yaml. They matter on restricted hardware — see
# docs/user/hardware-and-remote-engines.md.
#

# Piper TTS: path to a local .onnx voice model (engine-direct; the file-based
# equivalent is engines.tts.piper.model_path). Piper is local-only.
# AUTOMEDIA_PIPER_MODEL_PATH=/path/to/voice.onnx

# faster-whisper ASR: model size name (tiny/base/small/...) or a local
# CTranslate2 model directory (engine-direct; file-based equivalent is
# engines.asr.faster-whisper.model_path). faster-whisper is local-only.
# AUTOMEDIA_FASTER_WHISPER_MODEL=base

# Local (Pillow) image fallback: font file used when no CJK system font is
# detected (engine-direct). The local engine is the offline image fallback.
# AUTOMEDIA_LOCAL_IMAGE_FONT=/path/to/font.ttf

# External API Keys (optional)
# ============================================================

# Azure Speech (commercial TTS — reliable narration voice; optional).
# When set, the azure engine leads the TTS fallback chain
# (engines.tts.chain: [azure, piper, edge-tts]); without it the chain
# skips Azure transparently. Voice/format live in engines.tts.azure
# (defaults.yaml). Free-tier edge-tts is unreliable (common 403s).
# AUTOMEDIA_AZURE_SPEECH_KEY=your-azure-speech-key
# AUTOMEDIA_AZURE_SPEECH_REGION=eastasia

# Tavily Search API key for topic pool collection (optional).
# When unset, _search_tavily() returns an empty list gracefully.
# Get a key at https://tavily.com/api
# AUTOMEDIA_TAVILY_API_KEY=tvly-your-key-here

# AI-taste detector API key for the env-gated gptzero_style_api detector
# (optional). When unset, the detector registers but reports unavailable()
# and is skipped by detect_text().
# AUTOMEDIA_DETECTOR_GPTZERO_API_KEY=your-key-here

# ============================================================
# Notifications (optional)
# ============================================================

# Feishu/Lark webhook URL for publishing notifications
# FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/xxx

# WeChat Official Account credentials
# WX_APPID=your-app-id
# WX_APPSECRET=your-app-secret

# ============================================================
# Omni Triad Integration (optional)
# ============================================================
# See docs/omni-integration.md for configuration details.
# OPP (pre-processing), OL (localization), ORF (re-formatting)
